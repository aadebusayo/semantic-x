{
  "openapi": "3.0.0",
  "info": {
    "title": "Planner Service",
    "description": "Service for creating and managing workflow plans",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/plans": {
      "post": {
        "operationId": "createPlan",
        "summary": "Create a new workflow plan",
        "description": "Creates a structured plan based on user intent and available tools",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          }
        }
      }
    },
    "/plans/{planId}": {
      "get": {
        "operationId": "getPlan",
        "summary": "Get a specific plan",
        "parameters": [
          {
            "name": "planId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plan retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePlanRequest": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "description": "The user's primary intent"
          },
          "context": {
            "type": "object",
            "description": "Additional context for plan creation"
          },
          "availableTools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of available tool names"
          }
        },
        "required": ["intent"]
      },
      "Plan": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "description": "Unique identifier for the plan"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            }
          },
          "estimatedDuration": {
            "type": "string",
            "description": "Estimated time to complete the plan"
          },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Complexity level of the plan"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "completed", "cancelled"],
            "description": "Current status of the plan"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the plan was created"
          }
        }
      },
      "PlanStep": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string",
            "description": "Unique identifier for the step"
          },
          "order": {
            "type": "integer",
            "description": "Order of execution for this step"
          },
          "action": {
            "type": "string",
            "description": "Description of the action to perform"
          },
          "agent": {
            "type": "string",
            "description": "Which agent should handle this step"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tools required for this step"
          },
          "expectedOutcome": {
            "type": "string",
            "description": "What should happen when this step completes"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Steps that must complete before this one"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed"],
            "description": "Current status of this step"
          }
        },
        "required": ["stepId", "order", "action", "agent"]
      }
    }
  }
}
