# SemanticX Framework Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=SemanticX Framework
APP_VERSION=1.0.0
DEBUG=false

# Server Settings
HOST=127.0.0.1
PORT=8000
RELOAD=true

# LLM Provider Settings
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000

# Azure OpenAI Settings (alternative)
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
# AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Vector Database Settings
VECTOR_STORE_TYPE=memory
# For Qdrant (recommended open-source)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=semanticx
# VECTOR_STORE_TYPE=pinecone
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_ENVIRONMENT=your_pinecone_environment
# PINECONE_INDEX_NAME=your_index_name

# VECTOR_STORE_TYPE=weaviate
# WEAVIATE_URL=your_weaviate_url
# WEAVIATE_API_KEY=your_weaviate_api_key

# VECTOR_STORE_TYPE=chroma
# CHROMA_PERSIST_DIRECTORY=./chroma_db

# VECTOR_STORE_TYPE=qdrant
# QDRANT_URL=your_qdrant_url
# QDRANT_API_KEY=your_qdrant_api_key

# Tool and Schema Settings
TOOL_SCHEMA_DIR=./schemas
TOOL_DEFAULTS_FILE=./tool_defaults.json

# Prompt Settings
PROMPT_DIR=./prompts

# Session Settings
SESSION_TIMEOUT_MINUTES=30
MAX_CONVERSATION_HISTORY=100

# Memory Settings
ENABLE_CONVERSATION_SUMMARIZATION=true
ENABLE_VECTOR_STORAGE=true
MEMORY_RETENTION_DAYS=90

# Error Handling Settings
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=1.0

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# CORS Settings
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=true

# Security Settings
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
