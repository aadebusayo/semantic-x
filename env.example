# Infosearch API Configuration
# Copy to .env and fill in your values

APP_NAME=Infosearch API
APP_VERSION=0.1.0
DEBUG=false

HOST=127.0.0.1
PORT=8000
RELOAD=true

# CORS (JSON list)
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=true

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_INDEX=<index-name>
AZURE_SEARCH_API_KEY=<admin-or-query-key>
AZURE_SEARCH_DATASOURCE_NAME=
AZURE_SEARCH_SKILLSET_NAME=
AZURE_SEARCH_INDEXER_NAME=
AZURE_SEARCH_RUN_INDEXER_NOW=false

# Optional: semantic configuration name (if enabled on your index)
# AZURE_SEARCH_SEMANTIC_CONFIG=default

# Azure OpenAI (required for chat answers)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_MAX_TOKENS=400

# Field mapping (match your index)
SEARCH_CONTENT_FIELD=content
SEARCH_VECTOR_FIELD=contentVector
SEARCH_DOC_ID_FIELD=documentId
SEARCH_DOC_NAME_FIELD=documentName
SEARCH_VECTOR_PROFILE_VECTORIZER=default-aoai-vectorizer
SEARCH_VECTOR_DIMENSIONS=1536

# Optional: filterable fields (match your index)
# SEARCH_FILTER_DOC_ID_FIELD=documentId
# SEARCH_FILTER_DOC_NAME_FIELD=documentName

# Cosmos DB
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=<primary-key>
COSMOS_DATABASE=infosearch
COSMOS_CHAT_CONTAINER=chats
COSMOS_SUGGESTIONS_CONTAINER=document_suggestions
COSMOS_INGESTION_CONTAINER=ingestion

# Blob ingestion (optional; pull-based, no queues)
ENABLE_INGESTION_WORKER=true
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=

# Ingestion polling
INGESTION_POLL_SECONDS=60

# Chunking
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# One-time backfill script (Entity metadata -> Blob -> AI Search)
COSMOS_ENTITY_CONTAINER=Entity
ENTITY_ROOT_BASEPATH_ID=0000-0000-0000-0000
ENTITY_FILE_OBJECT_TYPE=1

# Behavior
DEFAULT_TOP_K=5
MAX_EXCERPT_CHARS=280
# Minimum search score for a citation to be included (0.0 = no filter; try 0.03-0.1 for noisy indexes)
SEARCH_MIN_CITATION_SCORE=0.02
MAX_CHAT_MESSAGES=60
DEFAULT_USER_ID=anonymous
